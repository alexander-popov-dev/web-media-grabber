# Application
DEBUG=FALSE
BACKEND_HOST=your-domain.com
BACKEND_PORT=8000
CORS_ORIGINS=https://your-domain.com

# YouTube cookies (Docker bind-mount the file into /app/cookies)
# Leave the browser value empty in containers: there is no browser profile.
YT_COOKIES_BROWSER=
YT_COOKIES_FILE=/app/cookies/cookies_youtube.txt

# Best-effort Playwright refresh on bot detection.
COOKIES_AUTO_REFRESH=true

# If YouTube returns "Sign in to confirm you're not a bot" from this server's
# IP, no cookie or player-client change helps. Route outbound traffic through
# a residential/mobile proxy (http://user:pass@host:port). Used by both yt-dlp
# and the Playwright cookie refresh.
# Multiple endpoints can be comma-separated: a working one is remembered per
# video, and bot-checked endpoints are skipped on retry.
# YOUTUBE_PROXY=http://user:pass@host:port,http://user2:pass2@host2:port2

# Optional: override the bgutil PO token provider location.
# BGUTIL_POT_HOME=/app/bgutil-ytdlp-pot-provider/server
