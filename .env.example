# Application
DEBUG=FALSE
SECRET_KEY=your-secret-key-here-generate-with-openssl-rand-hex-32
BACKEND_HOST=your-domain.com
BACKEND_PORT=8000
CORS_ORIGINS=https://your-domain.com

# Database
POSTGRES_DB=media_downloader
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-redis-password

# Admin Bot (if used)
ADMIN_BOT_TOKEN=your-telegram-bot-token
ADMIN_BOT_PORT=8001

# Traefik
TRAEFIK_EMAIL=your-email@example.com

# Cookie-based authentication for platforms requiring auth
# Option 1: Browser-based (local development) - set to browser name: chrome, firefox, edge, etc.
YT_COOKIES_BROWSER=chrome
FB_COOKIES_BROWSER=chrome
IG_COOKIES_BROWSER=chrome
TT_COOKIES_BROWSER=chrome

# Option 2: Cookie file (production/containers) - path to Netscape format cookies.txt
# Platform-specific cookie files (used by providers):
YT_COOKIES_FILE=/app/cookies/cookies_youtube.txt
FB_COOKIES_FILE=/app/cookies/cookies_facebook.txt
IG_COOKIES_FILE=/app/cookies/cookies_instagram.txt
TT_COOKIES_FILE=/app/cookies/cookies_tiktok.txt

# Auto-refresh cookies via Playwright (set to true to enable)
COOKIES_AUTO_REFRESH=true
COOKIES_REFRESH_INTERVAL_HOURS=24